---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Hello, world! | My Website">
  <section class="intro" aria-labelledby="page-title">
    <p class="eyebrow">A new beginning</p>
    <h1 id="page-title">Hello, world<span>!</span></h1>
    <p class="welcome">Welcome to my website.</p>
  </section>
</BaseLayout>

<style>
  .intro {
    max-width: 48rem;
    padding-block: 3rem;
  }

  .eyebrow {
    margin: 0 0 1.25rem;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 400;
    line-height: 0.98;
  }

  h1 span {
    color: var(--color-accent);
  }

  .welcome {
    margin: 1.5rem 0 0;
    color: var(--color-muted);
    font-size: 1.1rem;
  }
</style>