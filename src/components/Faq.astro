---
const faqs = [
	{
		q: "네덜란드어를 아예 모르는 '노베이스'인데 수강할 수 있나요?",
		a: '네, 알파벳과 발음 규칙부터 1:1 속도에 맞춰 차근차근 시작하니 걱정하지 않으셔도 됩니다.',
	},
	{
		q: '수업은 온라인으로만 진행되나요?',
		a: '기본적으로 온라인 화상 수업으로 진행됩니다. 암스테르담 지역에 한해 대면 수업 조율이 가능합니다.',
	},
	{
		q: '수업 교재는 따로 구매해야 하나요?',
		a: '아니요, 시중 교재를 살 필요 없이 제 노하우가 담긴 맞춤형 노션(Notion) 워크스페이스와 PDF 자료를 모두 무료로 제공해 드립니다.',
	},
	{
		q: '야근이나 급한 일정 때문에 결석하면 보강이 되나요?',
		a: '직장인/대학생분들의 일정을 배려하여, 수업 시작 최소 24시간 전까지 연락 주시면 일정 변경 및 보강이 가능합니다.',
	},
	{
		q: '소그룹 수업은 모르는 사람들과 매칭되나요?',
		a: "아니요! 소그룹 클래스는 100% '지인 동반'으로만 운영됩니다. 직장 동료, 유학 중인 친구, 혹은 부부가 함께 그룹을 꾸려 신청해 주시면 됩니다. 친한 사람들과 묶음 할인도 받고 더 편안한 분위기에서 즐겁게 네덜란드어를 배워보세요.",
	},
	{
		q: 'Inburgering A2(또는 B1) 시험 합격까지 보통 얼마나 걸리나요?',
		a: '목표와 기존 실력에 따라 다르지만, 자체 제작한 쓰기/말하기 교재를 활용해 보통 A2는 1-2개월, B1은 3개월 내에 합격하는 것을 목표로 합니다.',
	},
];
---

<section class="bg-white px-6 py-20" aria-labelledby="faq-title">
	<div class="mx-auto max-w-3xl">
		<h2 id="faq-title" class="mb-10 text-center text-3xl font-bold text-gray-900">
			❓ 자주 묻는 질문
		</h2>

		<div class="border-t border-gray-200">
			{faqs.map((faq, index) => {
				const questionId = `faq-question-${index + 1}`;
				const answerId = `faq-answer-${index + 1}`;

				return (
					<div class="faq-item border-b border-gray-200" data-faq-item>
						<h3>
							<button
								id={questionId}
								class="group flex w-full items-center justify-between gap-6 py-5 text-left font-semibold text-gray-800 transition-colors hover:text-orange-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-orange-500"
								type="button"
								aria-expanded="false"
								aria-controls={answerId}
								data-faq-trigger
							>
								<span>{faq.q}</span>
								<svg class="faq-chevron size-5 shrink-0" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							</button>
						</h3>
						<div
							id={answerId}
							class="faq-panel grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out"
							role="region"
							aria-labelledby={questionId}
							aria-hidden="true"
							data-faq-panel
						>
							<div class="min-h-0 overflow-hidden">
								<p class="rounded-lg bg-orange-50/50 px-5 pt-1 pb-5 leading-relaxed text-gray-600">
									{faq.a}
								</p>
							</div>
						</div>
					</div>
				);
			})}
		</div>
	</div>
</section>

<script>
	const faqItems = document.querySelectorAll('[data-faq-item]');

	faqItems.forEach((item) => {
		const trigger = item.querySelector('[data-faq-trigger]');
		const panel = item.querySelector('[data-faq-panel]');

		trigger?.addEventListener('click', () => {
			const shouldOpen = !item.classList.contains('is-open');

			faqItems.forEach((otherItem) => {
				otherItem.classList.remove('is-open');
				otherItem.querySelector('[data-faq-trigger]')?.setAttribute('aria-expanded', 'false');
				otherItem.querySelector('[data-faq-panel]')?.setAttribute('aria-hidden', 'true');
			});

			if (shouldOpen) {
				item.classList.add('is-open');
				trigger.setAttribute('aria-expanded', 'true');
				panel?.setAttribute('aria-hidden', 'false');
			}
		});
	});
</script>

<style>
	.faq-item.is-open .faq-panel {
		grid-template-rows: 1fr;
	}

	.faq-chevron {
		transition: transform 180ms ease;
	}

	.faq-item.is-open .faq-chevron {
		transform: rotate(180deg);
	}

	@media (prefers-reduced-motion: reduce) {
		.faq-panel,
		.faq-chevron {
			transition: none;
		}
	}
</style>