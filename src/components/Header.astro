---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
  <a class="brand" href={`${baseUrl}/`}>Dutch Tangerine<span>.</span></a>
  <nav aria-label="주요 메뉴">
    <a href={`${baseUrl}/course/`}>수업 안내</a>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 5rem;
    border-bottom: 1px solid var(--color-line);
  }

  a {
    text-decoration: none;
  }

  .brand {
    font-weight: 700;
    letter-spacing: 0;
  }

  .brand span {
    color: #e7743d;
  }

  nav a {
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  nav a:hover,
  nav a:focus-visible {
    color: var(--color-accent);
  }
</style>